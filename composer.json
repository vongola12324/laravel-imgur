{
  "name": "vongola12324/laravel-imgur",
  "description": "Laravel wrapper for the Imgur API.",
  "keywords": [
    "laravel",
    "imgur"
  ],
  "homepage": "https://github.com/vongola12324/laravel-imgur",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Vongola",
      "email": "vongola12324@coder.tw"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "j0k3r/php-imgur-api-client": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0"
  },
  "autoload": {
    "psr-4": {
      "Vongola\\Imgur\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Vongola\\ImgurTests\\": "tests/"
    }
  },
  "extra": {
    "component": "package",
    "laravel": {
      "providers": [
        "Vongola\\Imgur\\ImgurServiceProvider"
      ],
      "aliases": {
        "Imgur": "Vongola\\Imgur\\Facades\\ImgurFacade"
      }
    }
  }
}
